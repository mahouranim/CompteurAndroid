<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Titre de l'application -->
    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_app"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <!-- Valeur actuelle du compteur -->
    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valeur_defaut"
        android:textSize="64sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <!-- Boutons + et - côte à côte -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/buttonDecrementer"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/bouton_decrementer"
            android:textSize="22sp"
            android:layout_marginEnd="24dp" />

        <Button
            android:id="@+id/buttonIncrementer"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/bouton_incrementer"
            android:textSize="22sp" />

    </LinearLayout>

    <!-- Bouton de réinitialisation -->
    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bouton_reinitialiser" />

</LinearLayout>